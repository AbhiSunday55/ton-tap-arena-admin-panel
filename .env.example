# Copy to .env and fill in. Never commit real values.
#
# DATABASE_URL — the Postgres connection string for the panel's own database.
# It is provisioned automatically in the platform sandbox; supply your own elsewhere.
# SESSION_SECRET — signing key for the admin session cookie.

